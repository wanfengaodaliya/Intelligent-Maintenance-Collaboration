# =============================================================================
# 阶段 7 交付环境变量模板（复制为实际 env 或按段导出）
#
# 网络模拟编排的 compose 文件：
#   internet_service/network_simulator/docker-compose.yml（Toxiproxy/MQTT/控制器）
#   edge_service/compose.network-sim.yml（双 Edge，经 Toxiproxy 链路）
# compose 文件可直接读取本文件：在 cloud_edge_project 下
#   docker compose --env-file edge_service/delivery.env.example ...
# =============================================================================

# ---- 网络模拟器（internet_service/network_simulator）----
# 绑定地址：默认仅本机；需要容器网络访问宿主机服务时保持 127.0.0.1 +
# host-gateway 即可（compose 已配置 extra_hosts）。
NETWORK_BIND_ADDRESS=127.0.0.1

# ---- 双 Edge（edge_service/compose.network-sim.yml）----
# 节点身份在 compose 内固定（edge_01/edge_02），无需覆盖。

# ---- 正式诊断模型（默认：Edge 进程内蒸馏 H5）----
EDGE_DIAGNOSTIC_BACKEND=local_h5
EDGE_MODEL_ROOT=/app/data/models
# 自动更新默认关闭；显式开启时不得同时设置 EDGE_MODEL_VERSION。
EDGE_MODEL_UPDATE_POLLER_ENABLED=false
# 版本 pin（可选，严格锁定）：设置后 Poller 必须保持关闭。
# EDGE_MODEL_VERSION=distilled_h5_kd_fold3_a9f20442

# official 后端仅用于远端模型服务对照/故障演练：
# EDGE_DIAGNOSTIC_BACKEND=official
EDGE_MODEL_BASE_URL=http://host.docker.internal:8012

# ---- 宿主机业务服务（可选，完整链路演示时启动）----
# Scheduler: 8003（注册 edge_01/edge_02 的 control_url 走 Toxiproxy 18042/18052）
# Cloud:     8004
SCHEDULER_HEALTH_URL=http://127.0.0.1:8003/health
CLOUD_HEALTH_URL=http://127.0.0.1:8004/health

# ---- 健康检查脚本（edge_service/scripts/health_check.py）----
# 以上变量直接复用；脚本默认地址与 compose 暴露端口一致，无需额外配置。
