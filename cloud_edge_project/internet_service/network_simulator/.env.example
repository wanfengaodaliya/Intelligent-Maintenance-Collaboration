# Host interface used by every published Compose port. Keep loopback for local use.
NETWORK_BIND_ADDRESS=127.0.0.1

# Windows host address reachable from native Docker Engine inside WSL2.
# Keep host-gateway for Docker Desktop; for native WSL2 use the default route gateway.
NETWORK_HOST_GATEWAY=host-gateway

# Host port used to expose the read-only state API.
NETWORK_API_HOST_PORT=8090

# Host directory mounted as /app/config. Copy config/ to a VM-specific directory
# and set this value instead of editing the module source tree.
NETWORK_CONFIG_HOST_DIR=./config

# Optional for the default Compose file; when empty it follows
# NETWORK_CONFIG_HOST_DIR/mosquitto.conf. Linux VM deployment must set it.
NETWORK_MOSQUITTO_CONFIG_PATH=

# Container timezone used for ISO 8601 logs.
TZ=Asia/Shanghai

# Optional bearer token when reporter.yaml selects auth.mode=bearer.
NETWORK_REPORT_TOKEN=

# Optional JSON object for VM deployments. Keys are explicit HTTP link IDs and
# values are reachable host:port upstreams. Leave empty for local defaults.
NETWORK_LINK_UPSTREAMS_JSON=
