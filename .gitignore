# 项目内部 Git worktree 目录。
.worktrees/

# 本地 Python 虚拟环境。
.venv/
# Python bytecode caches.
**/__pycache__/
*.py[cod]

# 本地模型训练产物（parquet/jsonl/日志等运行时生成）。
cloud_edge_project/model_training/

# 本地接口差距分析报告。
interface-gap-analysis/

# TRAE HTML 分享包临时目录。
.trae-html-share-packages/

# 本地实验与训练产物（体积大，不上传）。
experiments/
local_experiment/

# 缓存目录。
.cache/
.pytest_cache/

# pytest 本地临时目录（--basetemp）。
.pytest_tmp/

# 本地运行产生的根级数据目录（SQLite 等运行时产物）。
/data/

# 环境变量文件（可能含密钥，仅保留不含密钥的 .env.example）。
.env
.env.*
!.env.example
