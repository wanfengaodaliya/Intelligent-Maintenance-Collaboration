# 项目内部 Git worktree 目录。
.worktrees/

# 本地 Python 虚拟环境。
.venv/

# Bearing-model source data and regenerated training outputs stay local.
cloud_edge_project/edge_service/model_training/bearing_random_forest/data/
cloud_edge_project/edge_service/model_training/bearing_random_forest/generated/

# Python bytecode caches.
**/__pycache__/
*.py[cod]

# 本地模型训练产物（parquet/jsonl/日志等运行时生成）。
cloud_edge_project/model_training/

# 本地接口差距分析报告。
interface-gap-analysis/

# TRAE HTML 分享包临时目录。
.trae-html-share-packages/

# pytest 本地临时目录（--basetemp）。
.pytest_tmp/

# 本地运行产生的根级数据目录（SQLite 等运行时产物）。
/data/
