# 项目内部 Git worktree 目录。
.worktrees/

# 本地 Python 虚拟环境。
.venv/
# Python bytecode caches.
**/__pycache__/
*.py[cod]

# 本地模型训练产物（parquet/jsonl/日志等运行时生成）。
cloud_edge_project/model_training/

# 本地接口差距分析报告。
interface-gap-analysis/

# TRAE HTML 分享包临时目录。
.trae-html-share-packages/

# 本地实验与训练产物（体积大，不上传）。
experiments/
local_experiment/

# 双阶段基准的定义与工具需要版本化；运行结果仍保持本地。
!cloud_edge_project/experiments/
cloud_edge_project/experiments/*
!cloud_edge_project/experiments/dual_phase_benchmark/
cloud_edge_project/experiments/dual_phase_benchmark/*
!cloud_edge_project/experiments/dual_phase_benchmark/ground_truth.json
!cloud_edge_project/experiments/dual_phase_benchmark/tools/
cloud_edge_project/experiments/dual_phase_benchmark/tools/*
!cloud_edge_project/experiments/dual_phase_benchmark/tools/__init__.py
!cloud_edge_project/experiments/dual_phase_benchmark/tools/dpb_common.py
!cloud_edge_project/experiments/dual_phase_benchmark/tools/build_manifest.py
!cloud_edge_project/experiments/dual_phase_benchmark/tools/memory.py
!cloud_edge_project/experiments/dual_phase_benchmark/tools/paired_eval.py
!cloud_edge_project/experiments/dual_phase_benchmark/tools/snapshot.py
!cloud_edge_project/experiments/dual_phase_benchmark/tools/timeline.py
!cloud_edge_project/experiments/dual_phase_benchmark/tests/

# 云端 MOMENT 运行资产由 Hugging Face 下载，不提交大模型文件。
/cloud_edge_project/model_assets/

# 缓存目录。
.cache/
.pytest_cache/

# pytest 本地临时目录（--basetemp）。
.pytest_tmp/

# 本地运行产生的根级数据目录（SQLite 等运行时产物）。
/data/

# 环境变量文件（可能含密钥，仅保留不含密钥的 .env.example）。
.env
.env.*
!.env.example

# Edge control shared secret (generated by start_project.ps1, keep local)
.edge_control_secret

# Microsoft Office temporary lock files.
~$*.docx

# 本地一次性报表/训练/基准/SSH 残留（清理项，不入库）。
/artifacts/
local_word/
word_render_*/
model_report_materials/
model_report_materials.zip
report_assets/
top10-risks-explained/
localcnn-temporal-ablation/
autodl_ssh/
/_verify_*
/_child_conda.ps1
/format_report_v02.py
/generate_charts.py
/generate_word_report.py
/optimize_report_v03.py
/refine_report_v04.py
/verify_report.py
/render_with_word.ps1
