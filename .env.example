# Copy this file to .env. start_project.ps1 loads it without overwriting values
# already supplied by the host environment.

# Local runtime and optional llama.cpp installation.
PROJECT_CONDA_ENV=moment
PROJECT_HEALTH_HOST=127.0.0.1
LLAMA_CPP_DIR=tools/llama.cpp
LLM_SERVICE_BIND_HOST=127.0.0.1
EDGE_SUGGESTION_LLM_HOST=127.0.0.1
EDGE_SUGGESTION_LLM_PORT=8005
EDGE_SUGGESTION_LLM_MODEL_PATH=models/qwen2.5-0.5b-instruct-q3_k_m.gguf
CLOUD_MODEL_UPDATE_LLM_HOST=127.0.0.1
CLOUD_MODEL_UPDATE_LLM_PORT=6006
CLOUD_MODEL_UPDATE_LLM_MODEL_PATH=models/qwen2.5-3b-instruct-q4_k_m.gguf
VLLM_URL=http://127.0.0.1:6006/v1/chat/completions
VLLM_MODEL_NAME=qwen-cloud
VLLM_MODEL_PATH=models/Qwen3-14B-AWQ
VLLM_HOST=127.0.0.1
VLLM_PORT=6006

# Host services.
SCHEDULER_SERVICE_HOST=127.0.0.1
SCHEDULER_SERVICE_PORT=8003
CLOUD_SERVICE_HOST=127.0.0.1
CLOUD_SERVICE_PORT=8004
CLOUD_SCHEDULER_SERVICE_BASE_URL=http://127.0.0.1:18045
CLOUD_BACKEND=moment_light_adapt
CLOUD_MOMENT_DEVICE=auto
CLOUD_REVIEW_DB_PATH=data/cloud_review.db
CLOUD_SUMMARY_DATABASE_PATH=data/cloud_summary.db
CLOUD_MOMENT_CHECKPOINT_PATH=model_assets/moment/releases/moment-scl05-final/best_model.pt
CLOUD_MOMENT_CONDITION_NORM_PATH=model_assets/moment/releases/moment-scl05-final/condition_norm.json
CLOUD_MOMENT_PRETRAINED_PATH=model_assets/moment/pretrained/MOMENT-1-small
CLOUD_MOMENT_DEPLOYMENT_DIR=model_assets/moment/releases/moment-scl05-final
GLOBAL_ANALYSIS_POLL_SECONDS=60

# Network simulator and host-side health probes.
NETWORK_COMPOSE_PROJECT=network_simulator
NETWORK_BIND_ADDRESS=127.0.0.1
NETWORK_HOST_GATEWAY=host-gateway
NETWORK_API_HOST=127.0.0.1
NETWORK_API_HOST_PORT=8090
NETWORK_CONFIG_HOST_DIR=./config
NETWORK_MOSQUITTO_CONFIG_PATH=
NETWORK_REPORT_TOKEN=
NETWORK_LINK_UPSTREAMS_JSON=
NETWORK_REQUIRED_PROXIES_JSON=["edge_01__to__scheduler__http","edge_01__to__cloud__http","scheduler__to__edge_01__http","edge_02__to__scheduler__http","edge_02__to__cloud__http","scheduler__to__edge_02__http","cloud__to__scheduler__http"]
TOXIPROXY_API_HOST=127.0.0.1
TOXIPROXY_API_PORT=8474
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
NETWORK_STUB_HOST_PORT=8000
TOXIPROXY_API_BASE_URL=http://toxiproxy:8474
NETWORK_SCHEDULER_URL=http://host.docker.internal:8003/scheduler/network-reports

# Edge Compose host mappings and topology. Container-internal URLs can point to
# DNS names, host.docker.internal, or addresses reachable from your deployment.
NETWORK_SIM_NETWORK=network_simulator_default
EDGE_01_HOST_PORT=8001
EDGE_02_HOST_PORT=8002
EDGE_01_NODE_ID=edge_01
EDGE_02_NODE_ID=edge_02
EDGE_SERVICE_HOST=0.0.0.0
EDGE_SERVICE_PORT=8001
EDGE_01_MQTT_HOST=mqtt-broker
EDGE_02_MQTT_HOST=mqtt-broker
EDGE_01_MQTT_PORT=1883
EDGE_02_MQTT_PORT=1883
EDGE_01_MQTT_CLIENT_ID=edge_01-runtime
EDGE_02_MQTT_CLIENT_ID=edge_02-runtime
EDGE_01_MQTT_INPUT_TOPIC=edge/edge_01/input
EDGE_02_MQTT_INPUT_TOPIC=edge/edge_02/input
EDGE_MQTT_DEVICE_RESULT_TOPIC=summary/device-results
EDGE_01_SCHEDULER_SERVICE_BASE_URL=http://toxiproxy:18011
EDGE_02_SCHEDULER_SERVICE_BASE_URL=http://toxiproxy:18051
EDGE_01_CLOUD_SERVICE_BASE_URL=http://toxiproxy:18021
EDGE_02_CLOUD_SERVICE_BASE_URL=http://toxiproxy:18053
EDGE_SUGGESTION_LLM_BASE_URL=http://host.docker.internal:8005
EDGE_MODEL_BASE_URL=http://host.docker.internal:8012
EDGE_MODEL_ROOT=/app/data/models
EDGE_V12_DATABASE_PATH=/app/data/edge_v12.db
EDGE_CLOUD_REVIEW_CACHE_DIR=/app/data/edge_cloud_review
EDGE_RAW_SAMPLE_DIRECTORY=/app/data/raw_analysis_samples
EDGE_PACKET_ROUTE_ERROR_LOG=/app/data/edge_packet_route_errors.jsonl
EDGE_01_NETWORK_LINK_ID=edge_01__to__scheduler__http
EDGE_02_NETWORK_LINK_ID=edge_02__to__scheduler__http
EDGE_01_NETWORK_STATUS_URL=http://network-controller:8090/api/v1/network/links/edge_01__to__scheduler__http
EDGE_02_NETWORK_STATUS_URL=http://network-controller:8090/api/v1/network/links/edge_02__to__scheduler__http
EDGE_01_STATUS_SCHEDULER_URL=http://toxiproxy:18011/api/v1/edge/status
EDGE_02_STATUS_SCHEDULER_URL=http://toxiproxy:18051/api/v1/edge/status
EDGE_01_STATUS_CLOUD_URL=http://toxiproxy:18021/api/v1/edge/status
EDGE_02_STATUS_CLOUD_URL=http://toxiproxy:18053/api/v1/edge/status
EDGE_STATUS_INTERVAL_SECONDS=1.0

# Optional standalone official model service.
EDGE_MODEL_PATH=models/Qwen2.5-1.5B-Instruct
EDGE_MODEL_SERVICE_HOST=127.0.0.1
EDGE_MODEL_SERVICE_PORT=8012

# Scheduler registry can be replaced without source edits for a different node set.
SCHEDULER_EDGE_NODES_JSON={"edge_01":{"control_url":"http://127.0.0.1:18042","target_topic":"edge/edge_01/input"},"edge_02":{"control_url":"http://127.0.0.1:18052","target_topic":"edge/edge_02/input"}}
